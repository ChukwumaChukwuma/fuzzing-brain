# WebFuzzingBrain Dockerfile
# Extends FuzzingBrain for web application security testing
# Includes Playwright browsers for automated vulnerability discovery

FROM ubuntu:22.04

# Prevent interactive prompts during package installation
ENV DEBIAN_FRONTEND=noninteractive

# Install system dependencies
RUN apt-get update && apt-get install -y \
    # Build essentials
    build-essential \
    git \
    wget \
    curl \
    # Python 3.10+
    python3.10 \
    python3-pip \
    python3.10-venv \
    # Go 1.21+
    golang-1.21 \
    # Node.js 18+ (for Playwright)
    ca-certificates \
    gnupg \
    # Browser dependencies for Playwright
    libnss3 \
    libnspr4 \
    libatk1.0-0 \
    libatk-bridge2.0-0 \
    libcups2 \
    libdrm2 \
    libdbus-1-3 \
    libxkbcommon0 \
    libxcomposite1 \
    libxdamage1 \
    libxfixes3 \
    libxrandr2 \
    libgbm1 \
    libpango-1.0-0 \
    libcairo2 \
    libasound2 \
    libatspi2.0-0 \
    # Additional tools
    vim \
    less \
    && rm -rf /var/lib/apt/lists/*

# Install Node.js 18.x
RUN curl -fsSL https://deb.nodesource.com/setup_18.x | bash - \
    && apt-get install -y nodejs \
    && npm install -g npm@latest

# Set up Go
ENV PATH="/usr/lib/go-1.21/bin:${PATH}"
ENV GOPATH="/go"
ENV PATH="${GOPATH}/bin:${PATH}"

# Create work directory
RUN mkdir -p /crs-workdir /crs/strategy /logs
WORKDIR /crs

# Copy Go backend code
COPY cmd/ ./cmd/
COPY internal/ ./internal/
COPY go.mod go.sum ./

# Build Go binaries
RUN go mod download && \
    go build -o bin/crs-server cmd/server/main.go && \
    go build -o bin/crs-worker cmd/worker/main.go && \
    go build -o bin/crs-local cmd/local/main.go

# Copy Python strategy code
COPY strategy/ ./strategy/

# Install Python dependencies
RUN pip3 install --no-cache-dir -r strategy/requirements.txt

# Install Playwright and browsers
# Note: This downloads ~500MB of browser binaries
RUN pip3 install playwright==1.48.0 && \
    playwright install chromium && \
    playwright install firefox && \
    playwright install webkit && \
    playwright install-deps

# Set Python path
ENV PYTHONPATH="/crs/strategy:${PYTHONPATH}"

# Create directories for POV storage
RUN mkdir -p /crs-workdir/successful_web_povs \
             /crs-workdir/successful_povs \
             /crs-workdir/patch_workspace \
             /logs

# Environment variables for web fuzzing
ENV BROWSER_TYPE=chromium \
    HEADLESS=true \
    CAPTURE_SCREENSHOTS=true \
    BROWSER_TIMEOUT=30 \
    MAX_BROWSER_INSTANCES=3 \
    CRS_WORKDIR=/crs-workdir

# Expose ports
# 7080 - CRS server
# 9081-9099 - Worker nodes (up to 19 workers)
EXPOSE 7080 9081-9099

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:7080/status/ || exit 1

# Default command (can be overridden)
CMD ["./bin/crs-server"]

# Labels
LABEL maintainer="WebFuzzingBrain Team"
LABEL description="Web Application Security Testing with LLM-Guided Fuzzing"
LABEL version="1.0.0"
LABEL org.opencontainers.image.source="https://github.com/o2lab/fuzzing-brain"
